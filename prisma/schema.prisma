generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(ADMIN)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("admin_sessions")
}

model Category {
  id                String            @id @default(cuid())
  name              String            @unique
  slug              String            @unique
  label             String
  description       String?
  imageUrl          String?
  displayOrder      Int               @default(0)
  isVisible         Boolean           @default(true)
  isPublished       Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productCategories ProductCategory[]
  @@map("categories")
}

model Product {
  id                   String                   @id @default(cuid())
  name                 String
  slug                 String                   @unique
  sku                  String?
  shortDescription     String?
  description          String                   @default("")
  priceInPaise         Int
  originalPriceInPaise Int?
  currency             String                   @default("INR")
  status               ProductStatus            @default(DRAFT)
  isFeatured           Boolean                  @default(false)
  isNew                Boolean                  @default(false)
  displayOrder         Int                      @default(0)
  badgeText            String?
  primaryImageUrl      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  publishedAt          DateTime?
  images               ProductImage[]
  specifications       ProductSpecification[]
  categories           ProductCategory[]
  marketplaceLinks     ProductMarketplaceLink[]
  discountProducts     DiscountProduct[]
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_images")
}

model ProductSpecification {
  id           String  @id @default(cuid())
  productId    String
  label        String
  value        String?
  displayOrder Int     @default(0)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_specifications")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
  @@map("product_categories")
}


model Marketplace {
  id           String                   @id @default(cuid())
  name         String                   @unique
  slug         String                   @unique
  displayOrder Int                      @default(0)
  isActive     Boolean                  @default(true)
  badgeText    String?
  badgeColor   String?
  tagline      String?
  buttonText   String?
  url          String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  productLinks ProductMarketplaceLink[]

  @@map("marketplaces")
}


model ProductMarketplaceLink {
  id            String      @id @default(cuid())
  productId     String
  marketplaceId String
  url           String
  isActive      Boolean     @default(true)
  displayOrder  Int         @default(0)
  updatedAt     DateTime    @updatedAt
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  @@unique([productId, marketplaceId])
  @@map("product_marketplace_links")
}

model DiscountCampaign {
  id               String            @id @default(cuid())
  name             String
  description      String?
  discountLabel    String?
  isActive         Boolean           @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  discountProducts DiscountProduct[]
  @@map("discount_campaigns")
}

model DiscountProduct {
  campaignId String
  productId  String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([campaignId, productId])
  @@map("discount_products")
}

model HomepageBanner {
  id             String    @id @default(cuid())
  eyebrow        String
  title          String
  description    String
  imageUrl       String
  mobileImageUrl String?
  buttonLabel    String?   @default("SHOP NOW")
  buttonTarget   String?   @default("Shop All")
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@map("homepage_banners")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
  @@map("site_settings")
}

model ContentSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String?
  metadata  Json?
  updatedAt DateTime @updatedAt
  @@map("content_sections")
}

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("faqs")
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime   @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  @@map("audit_logs")
}
